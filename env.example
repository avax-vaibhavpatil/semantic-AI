# =============================================================================
# Environment Configuration for Auto-Semantic BI Platform
# =============================================================================
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
DATABASE_URL=postgresql://postgres:root@localhost:5430/analytics-llm

# =============================================================================
# AI API CONFIGURATION (Choose ONE)
# =============================================================================

# Option 1: Groq API (Recommended - Fast & Free tier available)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# Option 2: OpenAI API (Alternative)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# APPLICATION CONFIGURATION (REQUIRED)
# =============================================================================
SEMANTIC_JSON=metadata/semantic.json

# =============================================================================
# INSTRUCTIONS:
# =============================================================================
# 1. Copy this file: cp env.example .env
# 2. Edit .env and replace "your-groq-api-key-here" with your actual key
# 3. Never commit .env to git (it's in .gitignore)
# 4. The backend will automatically load variables from .env

